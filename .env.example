# OpenAI 兼容的第三方模型配置（支持 agnes-2.5-flash 等）
OPENAI_API_BASE=https://your-api-endpoint/v1
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=agnes-2.5-flash

# 服务端口
PORT=8787

# 代理（可选）——Edge TTS 需直连 Microsoft 语音服务(wss://speech.platform.bing.com)，
# 若你的网络无法访问该服务，请配置 HTTP/HTTPS 代理，例如：
# HTTPS_PROXY=http://127.0.0.1:7890
